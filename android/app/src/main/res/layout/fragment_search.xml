<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- App Title Banner -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DOUYIN SMART FINDER"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <!-- 3 Search Mode Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/card_dark"
                app:tabTextColor="@color/text_secondary"
                app:tabSelectedTextColor="@color/accent"
                app:tabIndicatorColor="@color/accent"
                app:tabMode="fixed"
                app:tabGravity="fill">
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Tiếng Việt" />
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📹 Video" />
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔗 Link Douyin" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Search Inputs Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Mode 1: Smart Text Search -->
                    <LinearLayout
                        android:id="@+id/layoutSmartInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <EditText
                            android:id="@+id/etSmartQuery"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:hint="Nhập tiếng Việt: gái xinh mặc pijama che mặt..."
                            android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/bg_edit_text"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp"
                            android:text="gái xinh mặc pijama che mặt" />

                        <Button
                            android:id="@+id/btnPreviewKeywords"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="4dp"
                            android:text="👁️ Xem Trước Từ Khóa Tiếng Trung"
                            android:textColor="#38B2AC"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Mode 2: Video File Picker -->
                    <LinearLayout
                        android:id="@+id/layoutVideoInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btnPickVideo"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="📁 [UPLOAD VIDEO] Chọn File .mp4"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/primary" />

                        <TextView
                            android:id="@+id/tvSelectedVideoName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Chưa chọn file video"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etVideoHint"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:hint="Gợi ý chủ đề (tùy chọn)..."
                            android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/bg_edit_text"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Mode 3: Douyin URL -->
                    <LinearLayout
                        android:id="@+id/layoutUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etDouyinUrl"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:hint="Dán link Douyin / TikTok..."
                                android:textColorHint="@color/text_secondary"
                                android:textColor="@color/text_primary"
                                android:background="@drawable/bg_edit_text"
                                android:paddingHorizontal="12dp"
                                android:textSize="13sp"
                                android:text="https://www.douyin.com/video/7268899827364121901" />

                            <Button
                                android:id="@+id/btnPasteClipboard"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="6dp"
                                android:text="DÁN"
                                android:textSize="12sp"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Deep Search Toggle -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDeepSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="🔥 [DEEP SEARCH] Quét sâu (30 queries)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <!-- Primary Action Button -->
                    <Button
                        android:id="@+id/btnStartSearch"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:text="🚀 [SEARCH] BẮT ĐẦU TÌM KIẾM"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Keyword Preview Card (Collapsible) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardKeywordPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1A365D"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🇨🇳 TỪ KHÓA & SEARCH QUERIES TIẾNG TRUNG:"
                        android:textColor="#63B3ED"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• 美女穿睡衣遮脸\n• 美女睡衣自拍\n• 高颜值女生睡衣"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Progress Bar Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card_dark"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvProgressStage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đang phân tích và quét Douyin..."
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:progress="30" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Results Section Header & Filter Button -->
            <LinearLayout
                android:id="@+id/layoutResultsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvResultsHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DANH SÁCH VIDEO DOUYIN TƯƠNG ĐỒNG"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResultsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(5 video)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Results Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
