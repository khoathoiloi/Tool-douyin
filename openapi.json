    "/api/v1/search/{job_id}/results": {
      "get": {
        "tags": [
          "Android Mobile API v1"
        ],
        "summary": "Get paginated and ranked Douyin video results",
        "operationId": "api_v1_get_job_results_api_v1_search__job_id__results_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Results per page",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Results per page"
          },
          {
            "name": "min_score",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Minimum match percentage",
              "default": 70.0,
              "title": "Min Score"
            },
            "description": "Minimum match percentage"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "similarity, likes, comments, shares, newest",
              "default": "similarity",
              "title": "Sort By"
            },
            "description": "similarity, likes, comments, shares, newest"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
