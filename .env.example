# ==============================================================================
# DOUYIN SMART SEARCH & AI CENTRAL BACKEND CONFIGURATION (.env)
# ==============================================================================

# Server Metadata
PROJECT_NAME="Douyin Smart Search Engine"
VERSION="2.0.0"
API_V1_STR="/api"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# Database Connection (SQLite default, PostgreSQL/MySQL compatible via SQLAlchemy)
DATABASE_URL="sqlite:///./app.db"

# AI Provider Settings (gemini, openai, or offline)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your_google_gemini_api_key_here"
OPENAI_API_KEY=""

# Custom AI / Proxy URL (Leave empty for default Google/OpenAI endpoints)
AI_BASE_URL=""
AI_MODEL="gemini-1.5-flash"

# Douyin Search Crawler Provider (live or mock)
DOUYIN_SEARCH_PROVIDER="live"

# Douyin Web Session Cookie (Optional, recommended for high volume scraping)
DOUYIN_COOKIE=""

# Storage & Upload Limits
MAX_VIDEO_SIZE_MB=500

# Multi-Factor Re-Ranking Weights (Sum = 1.0)
WEIGHT_VISUAL=0.30
WEIGHT_SEMANTIC=0.25
WEIGHT_ACTION=0.15
WEIGHT_SCENE=0.10
WEIGHT_KEYWORD=0.15
WEIGHT_POPULARITY=0.05
